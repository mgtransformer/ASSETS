                let fileData = null;
                
                if (db && userId) {
                    const docSnap = await getDoc(doc(db, filesCollectionPath, id));
                    if (docSnap.exists()) fileData = docSnap.data();
                } else {
                    fileData = await getLocalFile(id);
                }

                if (fileData) {
                    const src = `data:${fileData.mimeType};base64,${fileData.data}`;
                    if (fileData.mimeType.startsWith('image/')) {
                        contentDiv.innerHTML = `<img src="${src}" class="max-w-full max-h-full object-contain rounded shadow-lg">`;
                    } else if (fileData.mimeType === 'application/pdf') {
                        contentDiv.innerHTML = `<iframe src="${src}" class="w-full h-full border-0 rounded shadow-lg"></iframe>`;
                    } else {
                        contentDiv.innerHTML = `<p class="text-slate-700">Unsupported file format.</p>`;
                    }
                } else {
                    contentDiv.innerHTML = `<div class="text-center text-slate-500"><i class="fa-solid fa-file-circle-xmark text-4xl mb-3 text-slate-300"></i><p>File not found. It may have been deleted or was too large to save initially.</p></div>`;
                }
            } catch (e) {
                console.error(e);
                contentDiv.innerHTML = `<p class="text-red-500 font-bold">Error loading file.</p>`;
