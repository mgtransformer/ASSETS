    <!-- MAIN LOGIC (Firebase + Logic) -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, deleteDoc, onSnapshot, collection, getDoc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Global State
        let billsData = [];
        window.pendingFiles = []; 
        let sortConfig = { key: 'invoiceDate', direction: 'desc' };
        
        window.sessionGeminiKey = '';
        window.sessionFirebaseKey = '';
        window.sessionSyncPin = '';

        // ==========================================
        // HARDCODED FIREBASE CONFIGURATION
        // ==========================================
        const MY_FIREBASE_CONFIG = {
            authDomain: "purchase-recon-app.firebaseapp.com",
            projectId: "purchase-recon-app",
            storageBucket: "purchase-recon-app.firebasestorage.app",
            messagingSenderId: "315987453777",
            appId: "1:315987453777:web:37c216fed45e15a0489570"
        };
        
        const appId = 'purchase-recon-app';
        const API_URL = "https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent";

        let app, db, auth, userId;
        let billsCollectionPath = '';
        let filesCollectionPath = '';

        // --- LOCAL DB FALLBACK (IndexedDB for Files) ---
        let localDb = null;
        function initLocalDB() {
            return new Promise((resolve, reject) => {
                const req = indexedDB.open('SmartReconDB', 1);
                req.onupgradeneeded = (e) => {
                    const db = e.target.result;
                    if (!db.objectStoreNames.contains('files')) db.createObjectStore('files', { keyPath: 'id' });
                };
                req.onsuccess = (e) => { localDb = e.target.result; resolve(); };
                req.onerror = (e) => reject(e);
            });
        }

        async function getLocalFile(id) {
            return new Promise((resolve) => {
                if (!localDb) return resolve(null);
                const tx = localDb.transaction('files', 'readonly');
                const req = tx.objectStore('files').get(id);
                req.onsuccess = () => resolve(req.result);
                req.onerror = () => resolve(null);
            });
        }

        async function saveLocalFile(id, data, mimeType) {
            return new Promise((resolve) => {
                if (!localDb) return resolve();
                const tx = localDb.transaction('files', 'readwrite');
                tx.objectStore('files').put({ id, data, mimeType });
                tx.oncomplete = () => resolve();
            });
        }
        
        async function deleteLocalFile(id) {
            return new Promise((resolve) => {
                if (!localDb) return resolve();
                const tx = localDb.transaction('files', 'readwrite');
                tx.objectStore('files').delete(id);
                tx.oncomplete = () => resolve();
            });
        }

        // --- API KEY MODAL LOGIC ---
        window.openApiModal = function() {
            const modal = document.getElementById('api-keys-modal');
            const content = document.getElementById('api-keys-modal-content');
            
            // Populate current keys
            document.getElementById('modal_gemini_key').value = localStorage.getItem('recon_gemini_key') || window.sessionGeminiKey;
            document.getElementById('modal_firebase_key').value = localStorage.getItem('recon_firebase_key') || window.sessionFirebaseKey;
            document.getElementById('modal_sync_pin').value = localStorage.getItem('recon_sync_pin') || window.sessionSyncPin;
            document.getElementById('save_keys_local').checked = localStorage.getItem('recon_save_keys') !== 'false';
            
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                content.classList.remove('scale-95');
            }, 10);
        }

        window.closeApiModal = function() {
            const modal = document.getElementById('api-keys-modal');
            const content = document.getElementById('api-keys-modal-content');
            modal.classList.add('opacity-0');
            content.classList.add('scale-95');
            setTimeout(() => modal.classList.add('hidden'), 300);
        }

        window.saveApiKeys = function() {
            const geminiKey = document.getElementById('modal_gemini_key').value.trim();
            const firebaseKey = document.getElementById('modal_firebase_key').value.trim();
            const syncPin = document.getElementById('modal_sync_pin').value.trim();
            const saveLocal = document.getElementById('save_keys_local').checked;

            if (saveLocal) {
                if(geminiKey) localStorage.setItem('recon_gemini_key', geminiKey);
                if(firebaseKey) localStorage.setItem('recon_firebase_key', firebaseKey);
                if(syncPin) localStorage.setItem('recon_sync_pin', syncPin);
                localStorage.setItem('recon_save_keys', 'true');
            } else {
                localStorage.removeItem('recon_gemini_key');
                localStorage.removeItem('recon_firebase_key');
                localStorage.removeItem('recon_sync_pin');
                localStorage.setItem('recon_save_keys', 'false');
            }

            // Save in session memory regardless
            window.sessionGeminiKey = geminiKey;
            window.sessionFirebaseKey = firebaseKey;
            window.sessionSyncPin = syncPin;

            window.closeApiModal();
            window.showCustomAlert("Settings Saved", "Your API keys and Sync PIN have been configured.", "success");
            
            // Re-run initialization to apply Firebase key / Sync PIN if it changed
            if(firebaseKey || syncPin) {
                initApp();
            }
        }

        function getActiveGeminiKey() {
            return (localStorage.getItem('recon_save_keys') !== 'false' ? localStorage.getItem('recon_gemini_key') : window.sessionGeminiKey) || '';
        }

        function getActiveFirebaseKey() {
            return (localStorage.getItem('recon_save_keys') !== 'false' ? localStorage.getItem('recon_firebase_key') : window.sessionFirebaseKey) || '';
        }

        function getActiveSyncPin() {
            return (localStorage.getItem('recon_save_keys') !== 'false' ? localStorage.getItem('recon_sync_pin') : window.sessionSyncPin) || '';
        }

        // --- APP INITIALIZATION ---
        let unsubscribeSnapshot = null;

        async function initApp() {
            try {
                document.getElementById('cloud-status').innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Connecting...';
                
                const fbKey = getActiveFirebaseKey();
                
                if (!fbKey) {
                    throw new Error("No Firebase API Key provided.");
                }

                // Inject API Key into config dynamically
                const config = { ...MY_FIREBASE_CONFIG, apiKey: fbKey };
                
                // Initialize only once if possible, or use existing
                if (!app) {
                    app = initializeApp(config);
                    auth = getAuth(app);
                    db = getFirestore(app);
                }

                await signInAnonymously(auth);

                onAuthStateChanged(auth, (user) => {
                    if (user) {
                        const customPin = getActiveSyncPin();
                        
                        // Use PIN to group devices, fallback to unique anon UID
                        userId = customPin ? `custom_sync_${customPin}` : user.uid;

                        billsCollectionPath = `artifacts/${appId}/users/${userId}/bills`;
                        filesCollectionPath = `artifacts/${appId}/users/${userId}/bill_files`;
                        document.getElementById('cloud-status').innerHTML = '<i class="fa-solid fa-cloud text-green-600"></i> Synced to Cloud';
                        setupRealtimeSync();
                    }
                });
            } catch (e) {
                console.warn("Falling back to Local Storage: ", e.message);
                document.getElementById('cloud-status').innerHTML = '<i class="fa-solid fa-hard-drive text-amber-500"></i> Local Device Data';
                
                // Clear any cloud references if initialization failed
                db = null; userId = null;
                
                await initLocalDB();
                
                if (window.__PORTABLE_BACKUP__) {
                    const data = window.__PORTABLE_BACKUP__;
                    billsData = data.bills || [];
                    localStorage.setItem('smart_recon_bills', JSON.stringify(billsData));
                    
                    if (data.files && data.files.length > 0) {
                        for(let f of data.files) {
                            await saveLocalFile(f.id, f.data, f.mimeType);
                        }
                    }
                    window.showCustomAlert("Backup Restored", "Successfully loaded all entries and bill images from this HTML file.", "success");
                    window.__PORTABLE_BACKUP__ = null; // Free memory
                } else {
                    billsData = JSON.parse(localStorage.getItem('smart_recon_bills')) || [];
                }

                window.updateMonthOptions();
                window.renderTable();
            }
        }

        function setupRealtimeSync() {
            if (!userId || !db) return;
            
            // Clean up previous listener if pin changed
            if (unsubscribeSnapshot) {
                unsubscribeSnapshot();
            }

            const q = collection(db, billsCollectionPath);
            
            unsubscribeSnapshot = onSnapshot(q, (snapshot) => {
                billsData = [];
                snapshot.forEach((doc) => {
                    billsData.push({ id: doc.id, ...doc.data() });
                });
                window.updateMonthOptions();
                window.renderTable();
            }, (error) => {
                console.error("Firestore sync error:", error);
                window.showCustomAlert("Sync Error", "Failed to sync data with cloud.", "error");
            });
        }

        async function saveBillToCloud(bill) {
            if (db && userId) {
                const docRef = doc(db, billsCollectionPath, bill.id);
                await setDoc(docRef, bill);
            } else {
                const existing = billsData.findIndex(b => b.id === bill.id);
                if (existing >= 0) billsData[existing] = bill; else billsData.push(bill);
                localStorage.setItem('smart_recon_bills', JSON.stringify(billsData));
                window.renderTable();
            }
        }

        async function saveFileToCloud(id, base64Data, mimeType) {
            if (db && userId) {
                const docRef = doc(db, filesCollectionPath, id);
                await setDoc(docRef, { data: base64Data, mimeType: mimeType });
            } else {
                await saveLocalFile(id, base64Data, mimeType);
            }
        }

        window.parseDate = function(dateStr) {
            if (!dateStr) return null;
            const parts = dateStr.split('/');
            if (parts.length === 3) return new Date(parts[2], parts[1] - 1, parts[0]);
            return new Date(dateStr);
        }

        window.getFY = function(dateStr) {
            const d = window.parseDate(dateStr);
            if (!d || isNaN(d)) return null;
            const month = d.getMonth() + 1;
            const year = d.getFullYear();
            return month >= 4 ? `FY${year}-${(year + 1).toString().slice(-2)}` : `FY${year - 1}-${year.toString().slice(-2)}`;
        }

        window.updateMonthOptions = function() {
            const fySelect = document.getElementById('fy_filter').value;
            const monthSelect = document.getElementById('month_filter');
            monthSelect.innerHTML = '<option value="all">All Months</option>';
            
            if (fySelect === 'all') {
                const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
                monthNames.forEach((name, i) => {
                    const m = (i + 1).toString().padStart(2, '0');
                    monthSelect.innerHTML += `<option value="${m}">${name}</option>`;
                });
            } else {
                const startYear = parseInt(fySelect.substring(2, 6));
                const endYear = startYear + 1;
                const fyMonths = [
                    { val: `04-${startYear}`, label: `April ${startYear}` }, { val: `05-${startYear}`, label: `May ${startYear}` },
                    { val: `06-${startYear}`, label: `June ${startYear}` }, { val: `07-${startYear}`, label: `July ${startYear}` },
                    { val: `08-${startYear}`, label: `August ${startYear}` }, { val: `09-${startYear}`, label: `September ${startYear}` },
                    { val: `10-${startYear}`, label: `October ${startYear}` }, { val: `11-${startYear}`, label: `November ${startYear}` },
                    { val: `12-${startYear}`, label: `December ${startYear}` }, { val: `01-${endYear}`, label: `January ${endYear}` },
                    { val: `02-${endYear}`, label: `February ${endYear}` }, { val: `03-${endYear}`, label: `March ${endYear}` }
                ];
                fyMonths.forEach(m => monthSelect.innerHTML += `<option value="${m.val}">${m.label}</option>`);
            }
        }

        function populateCategoryFilter() {
            const catSelect = document.getElementById('category_filter');
            const currentSelection = catSelect.value;
            const categories = new Set(billsData.map(b => b.category || 'Uncategorized'));
            const sortedCats = Array.from(categories).sort();
            
            catSelect.innerHTML = '<option value="all">All Categories</option>';
            sortedCats.forEach(cat => catSelect.innerHTML += `<option value="${cat}">${cat}</option>`);
            if (sortedCats.includes(currentSelection)) catSelect.value = currentSelection;
        }

        window.renderTable = function() {
            populateCategoryFilter();
            const tbody = document.getElementById('table_body');
            const searchTerm = document.getElementById('search_input').value.toLowerCase();
            const fyFilter = document.getElementById('fy_filter').value;
            const monthFilter = document.getElementById('month_filter').value;
            const categoryFilter = document.getElementById('category_filter').value;
            
            tbody.innerHTML = '';
            
            let filteredData = billsData.filter(bill => {
                const searchString = Object.values(bill).join(' ').toLowerCase();
                const matchesSearch = searchString.includes(searchTerm);
                
                const billFY = window.getFY(bill.invoiceDate);
                const matchesFY = (fyFilter === 'all') || (billFY === fyFilter);

                let matchesMonth = true;
                if (monthFilter !== 'all' && bill.invoiceDate) {
                    const parts = bill.invoiceDate.split('/');
                    if (parts.length === 3) {
                        if (fyFilter === 'all') matchesMonth = (parts[1] === monthFilter);
                        else matchesMonth = (`${parts[1]}-${parts[2]}` === monthFilter);
                    } else matchesMonth = false;
                }

                const cat = bill.category || 'Uncategorized';
                const matchesCat = (categoryFilter === 'all') || (cat === categoryFilter);

                return matchesSearch && matchesFY && matchesMonth && matchesCat;
            });

            if (sortConfig.key) {
                filteredData.sort((a, b) => {
                    let valA = a[sortConfig.key];
                    let valB = b[sortConfig.key];
                    if (sortConfig.key === 'invoiceDate') {
                        valA = window.parseDate(valA) || new Date(0);
                        valB = window.parseDate(valB) || new Date(0);
                    } else if (typeof valA === 'string') {
                        valA = valA.toLowerCase(); valB = valB.toLowerCase();
                    }
                    if (valA < valB) return sortConfig.direction === 'asc' ? -1 : 1;
                    if (valA > valB) return sortConfig.direction === 'asc' ? 1 : -1;
                    return 0;
                });
            }

            let totals = { gross: 0, net: 0, igst: 0, cgst: 0, sgst: 0 };

            if (filteredData.length === 0) {
                document.getElementById('empty_state').classList.remove('hidden');
            } else {
                document.getElementById('empty_state').classList.add('hidden');
                
                filteredData.forEach((bill, index) => {
                    totals.gross += Number(bill.grossAmount) || 0;
                    totals.net += Number(bill.netTaxableAmount) || 0;
                    totals.igst += Number(bill.igst) || 0;
                    totals.cgst += Number(bill.cgst) || 0;
                    totals.sgst += Number(bill.sgst) || 0;

                    const hasFile = bill.hasFile ? `<button onclick="window.viewFile('${bill.id}')" class="text-blue-500 hover:bg-blue-50 p-1.5 rounded" title="View Document"><i class="fa-solid fa-image"></i></button>` : `<span class="text-slate-300"><i class="fa-solid fa-file-slash"></i></span>`;

                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td class="col-center text-slate-500">${index + 1}</td>
                        <td class="col-center no-print">${hasFile}</td>
                        <td class="font-mono text-xs font-semibold">${bill.gstin || '-'}</td>
                        <td class="font-semibold text-slate-800 truncate max-w-[200px]" title="${bill.vendorName || ''}">${bill.vendorName || '-'}</td>
                        <td class="truncate max-w-[200px]" title="${bill.category || ''}"><span class="text-[10px] font-bold text-brand-700 bg-brand-50 uppercase tracking-wider px-2 py-0.5 rounded border border-brand-200">${bill.category || 'Uncategorized'}</span></td>
                        <td class="font-mono text-xs">${bill.invoiceNumber || '-'}</td>
                        <td class="font-mono text-xs">${bill.invoiceDate || '-'}</td>
                        <td class="col-num font-bold text-slate-800">${(Number(bill.grossAmount)||0).toFixed(2)}</td>
                        <td class="col-center bg-slate-50 font-semibold">${(Number(bill.taxPercent)||0).toFixed(0)}%</td>
                        <td class="col-num">${(Number(bill.netTaxableAmount)||0).toFixed(2)}</td>
                        <td class="col-num text-slate-500">${(Number(bill.igst)||0).toFixed(2)}</td>
                        <td class="col-num text-slate-500">${(Number(bill.cgst)||0).toFixed(2)}</td>
                        <td class="col-num text-slate-500">${(Number(bill.sgst)||0).toFixed(2)}</td>
                        <td class="col-center no-print">
                            <button onclick="window.confirmDelete('${bill.id}')" class="text-red-400 hover:text-red-600 hover:bg-red-50 p-1.5 rounded transition" title="Delete">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            }

            document.getElementById('foot_gross').textContent = totals.gross.toFixed(2);
            document.getElementById('foot_net').textContent = totals.net.toFixed(2);
            document.getElementById('foot_igst').textContent = totals.igst.toFixed(2);
            document.getElementById('foot_cgst').textContent = totals.cgst.toFixed(2);
            document.getElementById('foot_sgst').textContent = totals.sgst.toFixed(2);

            const formatter = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' });
            document.getElementById('dash_total_gross').textContent = formatter.format(totals.gross);
            document.getElementById('dash_total_net').textContent = formatter.format(totals.net);
            document.getElementById('dash_total_tax').textContent = formatter.format(totals.igst + totals.cgst + totals.sgst);
            document.getElementById('dash_bill_count').textContent = filteredData.length;
        }

        window.sortTable = function(key) {
            if (sortConfig.key === key) sortConfig.direction = sortConfig.direction === 'asc' ? 'desc' : 'asc';
            else { sortConfig.key = key; sortConfig.direction = 'asc'; }
            window.renderTable();
        }

        window.confirmDelete = function(id) {
            window.showCustomAlert("Confirm Deletion", "Are you sure you want to delete this bill? This cannot be undone.", "info", async function() {
                if(db && userId) {
                    await deleteDoc(doc(db, billsCollectionPath, id));
                    await deleteDoc(doc(db, filesCollectionPath, id)).catch(() => {});
                } else {
                    billsData = billsData.filter(b => b.id !== id);
                    localStorage.setItem('smart_recon_bills', JSON.stringify(billsData));
                    await deleteLocalFile(id);
                    window.renderTable();
                }
            });
        }

