        window.exportData = function() {
            if (billsData.length === 0) return window.showCustomAlert("Empty", "No data to export.", "info");
            
            const format = document.getElementById('export_format').value;
            const headers = ["Sr. No.", "GSTIN", "VENDOR NAME", "CATEGORY", "INV NO", "DATE", "GROSS", "% TAX", "NET TAXABLE", "IGST", "CGST", "SGST"];
            
            const searchTerm = document.getElementById('search_input').value.toLowerCase();
            const fyFilter = document.getElementById('fy_filter').value;
            const monthFilter = document.getElementById('month_filter').value;
            const catFilter = document.getElementById('category_filter').value;
            
            let exportDataList = billsData.filter(bill => {
                 const searchString = Object.values(bill).join(' ').toLowerCase();
                 if(!searchString.includes(searchTerm)) return false;
                 if(fyFilter !== 'all' && window.getFY(bill.invoiceDate) !== fyFilter) return false;
                 if(monthFilter !== 'all' && bill.invoiceDate) {
                     const parts = bill.invoiceDate.split('/');
                     const check = fyFilter === 'all' ? parts[1] : `${parts[1]}-${parts[2]}`;
                     if(check !== monthFilter) return false;
                 }
                 if(catFilter !== 'all' && (bill.category || 'Uncategorized') !== catFilter) return false;
                 return true;
            });
            
            if(sortConfig.key) {
                exportDataList.sort((a, b) => {
                    let vA = a[sortConfig.key], vB = b[sortConfig.key];
                    if (sortConfig.key === 'invoiceDate') { vA = window.parseDate(vA) || new Date(0); vB = window.parseDate(vB) || new Date(0); }
                    if (vA < vB) return sortConfig.direction === 'asc' ? -1 : 1;
                    if (vA > vB) return sortConfig.direction === 'asc' ? 1 : -1;
                    return 0;
                });
            }

            let t = { gross: 0, net: 0, igst: 0, cgst: 0, sgst: 0 };
            const exportRows = exportDataList.map((b, i) => {
                t.gross += Number(b.grossAmount)||0; t.net += Number(b.netTaxableAmount)||0;
                t.igst += Number(b.igst)||0; t.cgst += Number(b.cgst)||0; t.sgst += Number(b.sgst)||0;
                return [
                    i + 1, b.gstin || '', b.vendorName || '', b.category || '', b.invoiceNumber || '', b.invoiceDate || '',
                    (Number(b.grossAmount)||0).toFixed(2), (Number(b.taxPercent)||0)+'%', (Number(b.netTaxableAmount)||0).toFixed(2),
                    (Number(b.igst)||0).toFixed(2), (Number(b.cgst)||0).toFixed(2), (Number(b.sgst)||0).toFixed(2)
                ];
            });

            exportRows.push(["", "", "", "", "", "TOTALS:", t.gross.toFixed(2), "", t.net.toFixed(2), t.igst.toFixed(2), t.cgst.toFixed(2), t.sgst.toFixed(2)]);

            const fileName = `PurchaseRecon_${new Date().toISOString().split('T')[0]}`;

            if (format === 'pdf') {
                const { jsPDF } = window.jspdf;
                const doc = new jsPDF('l', 'pt', 'a4');
                doc.text("Purchase Bills Reconciliation", 40, 40);
                doc.autoTable({
                    head: [headers],
                    body: exportRows,
                    startY: 60,
                    styles: { fontSize: 8 },
                    headStyles: { fillColor: [2, 132, 199] },
                    footStyles: { fillColor: [241, 245, 249], textColor: [15, 23, 42], fontStyle: 'bold' },
                    willDrawCell: function(data) {
                        if (data.row.index === exportRows.length - 1) {
                            doc.setFillColor(241, 245, 249);
                            doc.setTextColor(15, 23, 42);
                            doc.setFont(undefined, 'bold');
                        }
                    }
                });
                doc.save(`${fileName}.pdf`);
            }
            else if (format === 'csv') {
                let csvContent = headers.join(",") + "\n";
                exportRows.forEach(row => { csvContent += row.map(c => `"${c}"`).join(",") + "\n"; });
                downloadFile(csvContent, 'text/csv;charset=utf-8;', `${fileName}.csv`);
            } else if (format === 'xlsx') {
                const ws = XLSX.utils.aoa_to_sheet([headers, ...exportRows]);
                const wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, ws, "Purchases");
                XLSX.writeFile(wb, `${fileName}.xlsx`);
            } else if (format === 'json') {
                downloadFile(JSON.stringify(exportDataList, null, 2), 'application/json;charset=utf-8;', `${fileName}.json`);
            } else if (format === 'txt') {
                let txtContent = headers.join("\t") + "\n";
                exportRows.forEach(row => { txtContent += row.join("\t") + "\n"; });
                downloadFile(txtContent, 'text/plain;charset=utf-8;', `${fileName}.txt`);
            }
        }

        window.downloadHTMLBackup = async function() {
            window.showCustomAlert("Preparing Backup", "Packing your app, database, and all bill images into a single portable HTML file. This may take a few moments depending on image count...", "info");
            
            setTimeout(async () => {
                try {
                    let allFiles = [];
                    if (localDb) {
                        allFiles = await new Promise((resolve) => {
                            const tx = localDb.transaction('files', 'readonly');
                            const req = tx.objectStore('files').getAll();
                            req.onsuccess = () => resolve(req.result);
                            req.onerror = () => resolve([]);
                        });
                    }

                    const backupData = { bills: billsData, files: allFiles };
                    
                    const scriptId = 'portable-backup-data';
                    let oldScript = document.getElementById(scriptId);
                    if(oldScript) oldScript.remove();

                    const scriptTag = document.createElement('script');
                    scriptTag.id = scriptId;
                    const safeJson = JSON.stringify(backupData).replace(/<\/script>/g, '<\\/script>');
                    scriptTag.textContent = `window.__PORTABLE_BACKUP__ = ${safeJson};`;
                    document.body.appendChild(scriptTag);

                    const html = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
                    
                    document.body.removeChild(scriptTag);
                    
                    const dateStr = new Date().toISOString().split('T')[0];
                    downloadFile(html, 'text/html;charset=utf-8;', `ReconTool_Portable_Backup_${dateStr}.html`);
                    window.closeAlert();
                } catch(e) {
                    console.error(e);
                    window.showCustomAlert("Backup Failed", "Could not generate portable backup.", "error");
                }
            }, 500);
        }

        function downloadFile(content, mimeType, fileName) {
            const b = new Blob([content], { type: mimeType });
            const a = document.createElement("a");
            a.href = URL.createObjectURL(b); a.download = fileName;
            document.body.appendChild(a); a.click(); document.body.removeChild(a);
        }

        // Custom Alert System with callback support
        window.showCustomAlert = function(title, message, type = 'info', confirmCallback = null) {
            const modal = document.getElementById('alert-modal');
            const iconEl = document.getElementById('alert-icon');
            const confirmBtn = document.getElementById('alert-confirm-btn');
            
            document.getElementById('alert-title').textContent = title;
            document.getElementById('alert-message').textContent = message;
            
            if (type === 'error') iconEl.innerHTML = '<i class="fa-solid fa-circle-exclamation text-red-500"></i>';
            else if (type === 'success') iconEl.innerHTML = '<i class="fa-solid fa-circle-check text-green-500"></i>';
            else iconEl.innerHTML = '<i class="fa-solid fa-circle-info text-blue-500"></i>';

            if (confirmCallback) {
                confirmBtn.classList.remove('hidden');
                confirmBtn.onclick = () => {
                    confirmCallback();
                    window.closeAlert();
                };
            } else {
                confirmBtn.classList.add('hidden');
                confirmBtn.onclick = null;
            }

            modal.classList.remove('hidden');
            setTimeout(() => modal.classList.remove('opacity-0'), 10);
        }

        window.closeAlert = function() {
            document.getElementById('alert-modal').classList.add('opacity-0');
            setTimeout(() => document.getElementById('alert-modal').classList.add('hidden'), 300);
        }

        // Run Init
        initApp();
    </script>
