<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Purchase Bills Reconciliation PRO</title>
    
    <!-- PWA & Mobile App Meta Tags -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#0ea5e9">
    <link rel="apple-touch-icon" href="https://ui-avatars.com/api/?name=PR&background=0ea5e9&color=fff&size=256">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Export Libraries -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        brand: { 50: '#f0f9ff', 100: '#e0f2fe', 500: '#0ea5e9', 600: '#0284c7', 700: '#0369a1', 900: '#0c4a6e' }
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #f8fafc; color: #0f172a; }
        .glass-panel { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border: 1px solid rgba(226, 232, 240, 0.8); }
        .table-container { overflow-x: auto; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); border-radius: 0.5rem; }
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 4px; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        table { border-collapse: separate; border-spacing: 0; width: 100%; min-width: 1300px; }
        th, td { border: 1px solid #e2e8f0; padding: 0.5rem 0.75rem; text-align: left; white-space: nowrap; }
        th { background-color: #f8fafc; font-weight: 600; color: #334155; position: sticky; top: 0; z-index: 10; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
        td { font-size: 0.875rem; background-color: #ffffff; }
        tr:hover td { background-color: #f1f5f9; }
        .col-num { text-align: right; font-variant-numeric: tabular-nums; }
        .col-center { text-align: center; }
        .scan-line { position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(to right, transparent, #0ea5e9, transparent); animation: scan 2s infinite linear; opacity: 0; }
        @keyframes scan { 0% { top: 0; opacity: 1; } 100% { top: 100%; opacity: 0; } }
        .modal-backdrop { backdrop-filter: blur(5px); }

        @media print {
            body { background-color: #ffffff; }
            header, .glass-panel, .no-print, .modal-backdrop { display: none !important; }
            main { padding: 0 !important; margin: 0 !important; max-width: 100% !important; }
            .table-container { box-shadow: none !important; border: none !important; overflow: visible !important; }
            table { min-width: 100% !important; border: 1px solid #000; }
            th, td { border: 1px solid #000 !important; padding: 6px !important; font-size: 10px !important; white-space: normal !important; color: #000 !important; }
            th { position: static !important; background-color: #f1f5f9 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            @page { size: landscape; margin: 10mm; }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- HEADER -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-sm">
        <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="bg-brand-600 text-white p-2 rounded-lg no-print">
                    <i class="fa-solid fa-file-invoice-dollar text-xl"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-slate-800 leading-tight">Purchase Recon <span class="text-brand-600 text-sm font-semibold px-2 py-0.5 bg-brand-50 rounded-full ml-2 no-print">PRO</span></h1>
                    <p class="text-xs text-slate-500 font-medium tracking-wide flex items-center gap-2">
                        Smart Directory & AI Extractor 
                        <span id="cloud-status" class="bg-slate-100 text-slate-600 px-2 py-0.5 rounded text-[10px]"><i class="fa-solid fa-spinner fa-spin"></i> Connecting...</span>
                    </p>
                </div>
            </div>
            
            <div class="flex items-center gap-3">
                <!-- NEW API MODAL BUTTON -->
                <button onclick="window.openApiModal()" class="no-print bg-amber-50 text-amber-700 hover:bg-amber-100 px-4 py-1.5 rounded-md text-xs font-bold transition flex items-center gap-2 shadow-sm border border-amber-200 mr-2">
                    <i class="fa-solid fa-key text-amber-500"></i> Configure Sync & APIs
                </button>

                <button onclick="window.downloadHTMLBackup()" class="no-print bg-slate-100 text-slate-700 hover:bg-slate-200 px-3 py-1.5 rounded-md text-xs font-bold transition flex items-center gap-2 shadow-sm border border-slate-300">
                    <i class="fa-solid fa-download"></i> Backup Tool
                </button>
                <div class="no-print flex items-center gap-2">
                    <select id="export_format" class="text-sm border border-slate-300 rounded-md px-2 py-1.5 focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white shadow-sm font-medium">
                        <option value="pdf">PDF Document</option>
                        <option value="xlsx">Excel (XLSX)</option>
                        <option value="csv">CSV File</option>
                        <option value="json">JSON Data</option>
                        <option value="txt">Text Table</option>
                    </select>
                    <button onclick="window.exportData()" class="bg-slate-800 text-white px-4 py-1.5 rounded-md text-sm font-medium hover:bg-slate-700 transition flex items-center gap-2 shadow-sm">
                        <i class="fa-solid fa-file-export"></i> Export
                    </button>
                    <button onclick="window.print()" class="bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 px-4 py-1.5 rounded-md text-sm font-medium transition flex items-center gap-2 shadow-sm ml-1">
                        <i class="fa-solid fa-print"></i> Print
                    </button>
                </div>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-[1600px] mx-auto w-full p-4 sm:p-6 lg:p-8 flex flex-col gap-6">

        <!-- AI INPUT SECTION -->
        <section class="glass-panel rounded-xl p-5 shadow-sm border border-brand-100 relative overflow-hidden">
            <div id="ai_loading_indicator" class="absolute inset-0 bg-white/80 z-20 hidden flex-col items-center justify-center backdrop-blur-sm">
                <i class="fa-solid fa-microchip fa-bounce text-4xl text-brand-500 mb-3"></i>
                <h3 class="text-lg font-bold text-slate-800">AI is analyzing & categorizing...</h3>
                <p class="text-sm text-slate-500 mt-1">Extracting vendor details, items, amounts, and GST.</p>
                <div class="w-64 h-2 bg-slate-200 rounded-full mt-4 overflow-hidden relative">
                    <div class="scan-line block opacity-100"></div>
                </div>
            </div>

            <div class="flex flex-col md:flex-row gap-4 items-start">
                <div class="bg-brand-50 border border-brand-200 text-brand-700 p-3 rounded-lg flex-shrink-0">
                    <i class="fa-solid fa-robot text-2xl"></i>
                </div>
                
                <div class="flex-grow w-full space-y-3">
                    <div class="flex justify-between items-center">
                        <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider flex items-center gap-2">
                            Smart Data Entry Copilot
                            <span class="bg-green-100 text-green-700 text-[10px] px-2 py-0.5 rounded-full font-bold"><i class="fa-solid fa-cloud-arrow-up"></i> Cloud Ready</span>
                        </h2>
                        <button onclick="window.openManualEntry()" class="bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100 px-3 py-1 rounded-md text-xs font-bold transition flex items-center gap-1 shadow-sm">
                            <i class="fa-solid fa-keyboard"></i> Manual Entry
                        </button>
                    </div>
                    
                    <textarea id="ai_prompt" rows="2" class="w-full text-sm border border-slate-300 rounded-md p-3 focus:outline-none focus:ring-2 focus:ring-brand-500 shadow-inner resize-none" placeholder="Drop files here, click 'Attach Bills', or paste bill text data. Tool automatically stores compressed bill copies."></textarea>
                    
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div class="flex gap-2">
                            <input type="file" id="file_input" multiple accept="image/*,.pdf" class="hidden">
                            <input type="file" id="native_camera_input" accept="image/*" capture="environment" class="hidden">
                            <button onclick="document.getElementById('file_input').click()" class="bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 px-3 py-1.5 rounded-md text-sm font-medium transition flex items-center gap-2 shadow-sm">
                                <i class="fa-solid fa-paperclip text-brand-500"></i> Attach Bills
                            </button>
                            
                            <button onclick="window.openCamera()" class="bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 px-3 py-1.5 rounded-md text-sm font-medium transition flex items-center gap-2 shadow-sm">
                                <i class="fa-solid fa-camera text-brand-500"></i> Capture Photo
                            </button>
                            
                            <span id="file_badge" class="hidden items-center bg-brand-100 text-brand-800 text-xs font-bold px-2.5 py-1 rounded-md border border-brand-200">
                                <span id="file_count">0</span> files queued
                                <i class="fa-solid fa-xmark ml-2 cursor-pointer hover:text-red-500" onclick="window.clearFiles()"></i>
                            </span>
                        </div>
                        
                        <button onclick="window.processAI()" class="bg-brand-600 hover:bg-brand-700 text-white px-6 py-1.5 rounded-md text-sm font-bold transition flex items-center gap-2 shadow-md">
                            <i class="fa-solid fa-wand-magic-sparkles"></i> Process with AI
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- DASHBOARD -->
        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white rounded-xl p-4 shadow-sm border border-slate-200 flex items-center justify-between">
                <div>
                    <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mb-1">Total Purchases</p>
                    <h3 class="text-2xl font-bold text-slate-800" id="dash_total_gross">₹0.00</h3>
                </div>
                <div class="bg-blue-50 text-blue-600 p-3 rounded-lg"><i class="fa-solid fa-wallet text-xl"></i></div>
            </div>
            
            <div class="bg-white rounded-xl p-4 shadow-sm border border-slate-200 flex items-center justify-between">
                <div>
                    <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mb-1">Net Taxable Amount</p>
                    <h3 class="text-2xl font-bold text-slate-800" id="dash_total_net">₹0.00</h3>
                </div>
                <div class="bg-emerald-50 text-emerald-600 p-3 rounded-lg"><i class="fa-solid fa-chart-pie text-xl"></i></div>
            </div>
            
            <div class="bg-white rounded-xl p-4 shadow-sm border border-slate-200 flex items-center justify-between">
                <div>
                    <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mb-1">Total Input Tax (GST)</p>
                    <h3 class="text-2xl font-bold text-slate-800" id="dash_total_tax">₹0.00</h3>
                </div>
                <div class="bg-orange-50 text-orange-600 p-3 rounded-lg"><i class="fa-solid fa-landmark text-xl"></i></div>
            </div>
            
            <div class="bg-white rounded-xl p-4 shadow-sm border border-slate-200 flex items-center justify-between">
                <div>
                    <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mb-1">Bills Processed</p>
                    <h3 class="text-2xl font-bold text-slate-800" id="dash_bill_count">0</h3>
                </div>
                <div class="bg-purple-50 text-purple-600 p-3 rounded-lg"><i class="fa-solid fa-file-lines text-xl"></i></div>
            </div>
        </section>

        <!-- TABLE SECTION -->
        <section class="bg-white rounded-xl shadow-sm border border-slate-200 flex flex-col h-full">
            <div class="p-4 border-b border-slate-200 flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center gap-2">
                    <h2 class="text-lg font-bold text-slate-800">Purchase Directory</h2>
                </div>
                
                <div class="flex flex-wrap items-center gap-3 no-print">
                    <div class="relative">
                        <i class="fa-solid fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400 text-sm"></i>
                        <input type="text" id="search_input" oninput="window.renderTable()" placeholder="Search ANY detail..." class="pl-9 pr-3 py-1.5 text-sm border border-slate-300 rounded-md focus:ring-2 focus:ring-brand-500 focus:outline-none w-56">
                    </div>
                    
                    <select id="fy_filter" onchange="window.updateMonthOptions(); window.renderTable()" class="text-sm border border-brand-300 text-brand-900 rounded-md px-3 py-1.5 focus:ring-2 focus:ring-brand-500 focus:outline-none bg-brand-50 font-bold shadow-sm">
                        <option value="all">All Financial Years</option>
                        <option value="FY2020-21">FY 2020-21</option>
                        <option value="FY2021-22">FY 2021-22</option>
                        <option value="FY2022-23">FY 2022-23</option>
                        <option value="FY2023-24">FY 2023-24</option>
                        <option value="FY2024-25">FY 2024-25</option>
                        <option value="FY2025-26">FY 2025-26</option>
                        <option value="FY2026-27">FY 2026-27</option>
                        <option value="FY2027-28">FY 2027-28</option>
                        <option value="FY2028-29">FY 2028-29</option>
                        <option value="FY2029-30">FY 2029-30</option>
                    </select>

                    <select id="month_filter" onchange="window.renderTable()" class="text-sm border border-slate-300 rounded-md px-3 py-1.5 focus:ring-2 focus:ring-brand-500 focus:outline-none bg-white font-medium min-w-[140px]">
                        <option value="all">All Months</option>
                    </select>

                    <select id="category_filter" onchange="window.renderTable()" class="text-sm border border-slate-300 rounded-md px-3 py-1.5 focus:ring-2 focus:ring-brand-500 focus:outline-none bg-white font-medium max-w-[160px] truncate">
                        <option value="all">All Categories</option>
                    </select>

                    <button onclick="window.clearAllData()" class="text-red-600 hover:bg-red-50 px-3 py-1.5 rounded-md text-sm font-medium transition border border-transparent hover:border-red-200 flex items-center gap-2 shadow-sm ml-2">
                        <i class="fa-solid fa-trash-can"></i> Clear All
                    </button>
                </div>
            </div>

            <div class="table-container flex-grow bg-white">
                <table id="recon_table">
                    <thead>
                        <tr>
                            <th class="w-12 col-center">Sr.</th>
                            <th class="w-16 col-center no-print">File</th>
                            <th class="w-32 cursor-pointer hover:bg-slate-100" onclick="window.sortTable('gstin')">GSTIN <i class="fa-solid fa-sort ml-1 text-slate-400 no-print"></i></th>
                            <th class="cursor-pointer hover:bg-slate-100" onclick="window.sortTable('vendorName')">VENDOR NAME <i class="fa-solid fa-sort ml-1 text-slate-400 no-print"></i></th>
                            <th class="w-40 cursor-pointer hover:bg-slate-100" onclick="window.sortTable('category')">CATEGORY / ITEM <i class="fa-solid fa-sort ml-1 text-slate-400 no-print"></i></th>
                            <th class="w-24">INVOICE NO</th>
                            <th class="w-24 cursor-pointer hover:bg-slate-100" onclick="window.sortTable('invoiceDate')">DATE <i class="fa-solid fa-sort ml-1 text-slate-400 no-print"></i></th>
                            <th class="w-32 col-num cursor-pointer hover:bg-slate-100" onclick="window.sortTable('grossAmount')">GROSS AMOUNT <i class="fa-solid fa-sort ml-1 text-slate-400 no-print"></i></th>
                            <th class="w-16 col-center bg-slate-50">% TAX</th>
                            <th class="w-28 col-num">NET TAXABLE</th>
                            <th class="w-24 col-num">IGST</th>
                            <th class="w-24 col-num">CGST</th>
                            <th class="w-24 col-num">SGST</th>
                            <th class="w-12 col-center no-print">Act</th>
                        </tr>
                    </thead>
                    <tbody id="table_body">
                        <!-- Data will be populated here -->
                    </tbody>
                    <tfoot class="bg-slate-50 font-bold text-slate-800 border-t-2 border-slate-300">
                        <tr>
                            <td colspan="7" class="text-right py-3 pr-4 uppercase tracking-wider text-xs">Total</td>
                            <td class="col-num py-3 text-brand-700" id="foot_gross">0.00</td>
                            <td></td>
                            <td class="col-num py-3 text-brand-700" id="foot_net">0.00</td>
                            <td class="col-num py-3 text-brand-700" id="foot_igst">0.00</td>
                            <td class="col-num py-3 text-brand-700" id="foot_cgst">0.00</td>
                            <td class="col-num py-3 text-brand-700" id="foot_sgst">0.00</td>
                            <td class="no-print"></td>
                        </tr>
                    </tfoot>
                </table>
                <div id="empty_state" class="hidden flex-col items-center justify-center py-16 text-slate-400">
                    <i class="fa-solid fa-folder-open text-4xl mb-3"></i>
                    <p class="text-sm font-medium">Directory is empty. Use AI or Manual Entry to add bills.</p>
                </div>
            </div>
        </section>
    </main>

    <!-- MODALS -->

    <!-- API Configuration Modal -->
    <div id="api-keys-modal" class="fixed inset-0 bg-slate-900/80 hidden z-[90] flex items-center justify-center opacity-0 transition-opacity modal-backdrop">
        <div class="bg-white rounded-xl shadow-2xl max-w-md w-full mx-4 flex flex-col transform transition-transform duration-300 scale-95" id="api-keys-modal-content">
            <div class="p-5 border-b border-slate-200 flex justify-between items-center bg-slate-50 rounded-t-xl">
                <h3 class="font-bold text-lg text-slate-800"><i class="fa-solid fa-shield-halved text-brand-600 mr-2"></i> Configure Settings</h3>
                <button onclick="window.closeApiModal()" class="text-slate-400 hover:text-red-500"><i class="fa-solid fa-xmark text-xl"></i></button>
            </div>
            <div class="p-6 space-y-5">
                <div class="bg-amber-50 border border-amber-200 text-amber-800 p-3 rounded-lg text-xs">
                    <i class="fa-solid fa-info-circle mr-1"></i> Keys are kept safely in your browser memory.
                </div>
                
                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-700 uppercase flex items-center gap-2">
                        <i class="fa-solid fa-microchip text-slate-400"></i> Gemini API Key 
                        <span class="bg-slate-100 text-slate-500 text-[9px] px-1.5 py-0.5 rounded font-bold">DATA EXTRACTION</span>
                    </label>
                    <input type="password" id="modal_gemini_key" class="w-full border border-slate-300 rounded p-2.5 text-sm font-mono focus:ring-2 focus:ring-brand-500 outline-none" placeholder="AIzaSy...">
                </div>
                
                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-700 uppercase flex items-center gap-2">
                        <i class="fa-solid fa-cloud text-slate-400"></i> Firebase API Key 
                        <span class="bg-slate-100 text-slate-500 text-[9px] px-1.5 py-0.5 rounded font-bold">CLOUD SYNC (Optional)</span>
                    </label>
                    <input type="password" id="modal_firebase_key" class="w-full border border-slate-300 rounded p-2.5 text-sm font-mono focus:ring-2 focus:ring-brand-500 outline-none" placeholder="AIzaSy...">
                </div>

                <div class="space-y-1 mt-4 pt-4 border-t border-slate-100">
                    <label class="text-xs font-bold text-slate-700 uppercase flex items-center gap-2">
                        <i class="fa-solid fa-sync text-slate-400"></i> Cross-Device Sync PIN
                        <span class="bg-green-100 text-green-700 text-[9px] px-1.5 py-0.5 rounded font-bold">NEW</span>
                    </label>
                    <p class="text-[10px] text-slate-500 mb-1 leading-tight">Enter a secret word or PIN (e.g., "MySecret123"). Use the same PIN on your phone and PC to see the same data.</p>
                    <input type="text" id="modal_sync_pin" class="w-full border border-slate-300 rounded p-2.5 text-sm font-mono focus:ring-2 focus:ring-brand-500 outline-none" placeholder="Enter a secure PIN...">
                </div>

                <div class="flex items-start gap-2 pt-2 border-t border-slate-100">
                    <input type="checkbox" id="save_keys_local" class="mt-0.5 rounded border-slate-300 text-brand-600 focus:ring-brand-500 cursor-pointer w-4 h-4" checked>
                    <label for="save_keys_local" class="text-xs text-slate-600 cursor-pointer leading-tight">
                        <strong class="text-slate-800">Save settings securely in this browser.</strong><br>
                        Prevents you from having to paste them every time.
                    </label>
                </div>
            </div>
            <div class="p-4 border-t border-slate-200 bg-slate-50 rounded-b-xl flex justify-end gap-3">
                <button onclick="window.closeApiModal()" class="px-4 py-2 rounded text-sm font-medium text-slate-600 hover:bg-slate-200">Cancel</button>
                <button onclick="window.saveApiKeys()" class="px-6 py-2 rounded text-sm font-bold text-white bg-brand-600 hover:bg-brand-700 shadow flex items-center gap-2">
                    <i class="fa-solid fa-check"></i> Save Settings
                </button>
            </div>
        </div>
    </div>

    <!-- Manual Entry Modal -->
    <div id="manual-modal" class="fixed inset-0 bg-slate-900/60 hidden z-[60] flex items-center justify-center opacity-0 transition-opacity modal-backdrop">
        <div class="bg-white rounded-xl shadow-2xl max-w-2xl w-full mx-4 flex flex-col max-h-[90vh]">
            <div class="p-5 border-b border-slate-200 flex justify-between items-center bg-slate-50 rounded-t-xl">
                <h3 class="font-bold text-lg text-slate-800"><i class="fa-solid fa-keyboard text-emerald-600 mr-2"></i> Manual Bill Entry</h3>
                <button onclick="window.closeManualEntry()" class="text-slate-400 hover:text-red-500"><i class="fa-solid fa-xmark text-xl"></i></button>
            </div>
            <div class="p-6 overflow-y-auto grid grid-cols-1 md:grid-cols-2 gap-5">
                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-600 uppercase">GSTIN</label>
                    <input type="text" id="man_gstin" class="w-full border border-slate-300 rounded p-2 text-sm font-mono uppercase" placeholder="27AAABC1234Z1">
                </div>
                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-600 uppercase">Vendor Name</label>
                    <input type="text" id="man_vendor" class="w-full border border-slate-300 rounded p-2 text-sm font-semibold" placeholder="Vendor Company Ltd">
                </div>
                <div class="space-y-1">
