        window.takeSnapshot = function() {
            const video = document.getElementById('camera-stream');
            const canvas = document.getElementById('camera-canvas');
            
            const MAX = 1000;
            let w = video.videoWidth;
            let h = video.videoHeight;
            if (w > h) { if (w > MAX) { h *= MAX / w; w = MAX; } } 
            else { if (h > MAX) { w *= MAX / h; h = MAX; } }
            
            canvas.width = w; 
            canvas.height = h;
            canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);
            
            const data = canvas.toDataURL('image/jpeg', 0.5).split(',')[1];
            window.pendingFiles.push({ mimeType: 'image/jpeg', data: data, name: 'Camera_Snapshot.jpg' });
            updateFileBadge();
            window.closeCamera();
        }

        window.processAI = async function() {
            const textPrompt = document.getElementById('ai_prompt').value.trim();
            if (window.pendingFiles.length === 0 && !textPrompt) {
                window.showCustomAlert("Input Required", "Please attach files, capture a photo, or paste data.", "error");
                return;
            }

            if (window.pendingFiles.length > 15) {
                window.showCustomAlert("Batch Size Too Large", "To ensure high accuracy and avoid free-tier timeout limits, please process a maximum of 10-15 bills at a time. Clear some files and try again.", "error");
                return;
            }

            const dynamicApiKey = getActiveGeminiKey();
            if (!dynamicApiKey) {
                window.showCustomAlert("Gemini API Key Required", "Please click 'Configure Sync & APIs' at the top right to paste your Gemini API Key before processing.", "error");
                return;
            }

            const loader = document.getElementById('ai_loading_indicator');
            loader.classList.remove('hidden'); loader.classList.add('flex');

            try {
                let parts = [];
                const strictInstructions = `You are a strict, highly accurate accounting data extraction AI. 
Extract data into a JSON object containing an array named "bills". Keys MUST be exact:
- 'gstin' (string, e.g. "27AABC1234Z1")
- 'vendorName' (string)
- 'category' (string, CRITICAL: DO NOT use generic words like "Service", "Items", or "Uncategorized". Extract the exact main item name or highly specific nature of service. Examples: "Crane Hire", "Copper Wires", "Filter Machine", "Paint", "Legal Fees", "Hotel Lodging", "Air Ticket". Be highly intelligent.)
- 'invoiceNumber' (string)
- 'invoiceDate' (string EXACTLY "DD/MM/YYYY")
- 'grossAmount' (number)
- 'taxPercent' (number, deduce if not explicit e.g. 5, 12, 18, 28)
- 'netTaxableAmount' (number)
- 'igst' (number)
- 'cgst' (number)
- 'sgst' (number)

RULES: Math must align (Net + Tax = Gross). If missing amounts but % exists, calc them (Interstate=IGST, Intrastate=CGST/SGST). Use 0 for missing numbers. Output ONLY pure JSON.
User context: ${textPrompt}`;
                
                parts.push({ text: strictInstructions });
                window.pendingFiles.forEach(file => {
                    parts.push({ inlineData: { mimeType: file.mimeType, data: file.data } });
                });

                const payload = {
                    contents: [{ role: "user", parts: parts }],
                    generationConfig: { responseMimeType: "application/json", temperature: 0.1 }
                };

                const response = await fetch(`${API_URL}?key=${dynamicApiKey}`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload)
                });
                const data = await response.json();

                if (data.error) throw new Error(data.error.message);

                if (data.candidates && data.candidates[0].content.parts[0].text) {
                    const parsedData = JSON.parse(data.candidates[0].content.parts[0].text);
                    if (parsedData && parsedData.bills && Array.isArray(parsedData.bills)) {
                        
                        for (let i = 0; i < parsedData.bills.length; i++) {
                            const bill = parsedData.bills[i];
                            const id = 'bill_ai_' + Date.now() + i;
                            bill.id = id;
                            bill.timestamp = Date.now();
                            
                            if (window.pendingFiles.length > 0) {
                                const fileIndex = Math.min(i, window.pendingFiles.length - 1);
                                const fileObj = window.pendingFiles[fileIndex];
                                
                                const isLocal = !(db && userId);
                                const sizeLimit = isLocal ? 10000000 : 950000; 
                                
                                if (fileObj.data.length < sizeLimit) { 
                                    bill.hasFile = true;
                                    await saveFileToCloud(id, fileObj.data, fileObj.mimeType);
                                } else {
                                    bill.hasFile = false;
                                    console.warn("File too large to save.");
                                }
                            } else {
                                bill.hasFile = false;
                            }
                            await saveBillToCloud(bill);
                        }
                        
                        window.clearFiles();
                        document.getElementById('ai_prompt').value = '';
                        window.showCustomAlert("Success", `Added ${parsedData.bills.length} bill(s).`, "success");
                    } else throw new Error("Invalid AI format.");
                } else throw new Error("Empty AI response.");

            } catch (err) {
                console.error(err);
                window.showCustomAlert("Failed", err.message, "error");
            } finally {
                loader.classList.add('hidden'); loader.classList.remove('flex');
            }
        }

